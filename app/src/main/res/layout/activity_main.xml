<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0D1117">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ DodgeBot"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#00FF88"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Dodge для Brawl Stars"
        android:textSize="13sp"
        android:textColor="#444466"
        android:gravity="center"
        android:paddingBottom="24dp"/>

    <!-- Статус -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/tvDodgeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● ВЫКЛЮЧЕН"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF4444"/>

            <TextView android:id="@+id/tvAccessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accessibility: не включён"
                android:textSize="12sp"
                android:textColor="#FF4444"
                android:paddingTop="6dp"/>

            <TextView android:id="@+id/tvMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим: Обычный"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingTop="4dp"/>

            <TextView android:id="@+id/tvDodgeCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Уклонений: 0"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Режим Mortis -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РЕЖИМ"
                android:textSize="10sp"
                android:textColor="#444466"
                android:letterSpacing="0.15"
                android:paddingBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/rbNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Обычный"
                    android:textColor="#CCCCCC"
                    android:checked="true"/>

                <RadioButton android:id="@+id/rbMortis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🦇 Mortis"
                    android:textColor="#CC88FF"/>
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvModeDesc"
                android:text="Уклон: страф в сторону от снаряда"
                android:textSize="11sp"
                android:textColor="#555577"
                android:paddingTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Кнопки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ВКЛЮЧИТЬ DODGE"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#00FF88"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Открыть Accessibility Settings"
        android:textSize="13sp"
        app:backgroundTint="#1A2A1A"
        android:layout_marginBottom="16dp"/>

    <!-- Инструкция -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F1A0F"
        app:cardCornerRadius="10dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="1. Нажми «Открыть Accessibility» → найди DodgeBot → включи\n2. Выбери режим\n3. Нажми ВКЛЮЧИТЬ DODGE\n4. Разреши захват экрана\n5. Играй — бот уклоняется сам\n\nMortis режим: уклон через тычку (dash) в сторону от снаряда, срабатывает не всегда — имитирует живого игрока"
            android:textSize="12sp"
            android:textColor="#448844"
            android:lineSpacingMultiplier="1.4"/>
    </androidx.cardview.widget.CardView>

</LinearLayout>
